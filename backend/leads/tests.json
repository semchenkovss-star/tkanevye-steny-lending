{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Валидация телефона",
      "method": "POST",
      "path": "/",
      "body": {
        "name": "Иван",
        "phone": "+7 (999) 1",
        "source": "Тест"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Метод не разрешён",
      "method": "GET",
      "path": "/",
      "expectedStatus": 405
    },
    {
      "name": "Бот с заполненной ловушкой отсеивается",
      "method": "POST",
      "path": "/",
      "body": {
        "name": "Bot",
        "phone": "+7 900 000-00-00",
        "source": "Автотест",
        "website": "http://spam.example"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true,
        "id": 0
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Слишком быстрая отправка отсеивается",
      "method": "POST",
      "path": "/",
      "body": {
        "name": "Bot",
        "phone": "+7 900 000-00-00",
        "source": "Автотест",
        "filledMs": 200
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true,
        "id": 0
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Неверная почта отклоняется",
      "method": "POST",
      "path": "/",
      "body": {
        "name": "Тест",
        "email": "not-an-email",
        "source": "Автотест"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}