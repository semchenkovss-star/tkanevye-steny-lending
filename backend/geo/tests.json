{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Определяет город по IP",
      "method": "GET",
      "path": "/?ip=95.161.221.1",
      "expectedStatus": 200,
      "expectedBody": { "city": "Санкт-Петербург", "country": "RU" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Неизвестный IP не ломает ответ",
      "method": "GET",
      "path": "/?ip=0.0.0.0",
      "expectedStatus": 200,
      "expectedBody": { "city": "string" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Метод не разрешён",
      "method": "POST",
      "path": "/",
      "expectedStatus": 405
    }
  ]
}
